# Database Type (required)
DB_TYPE=postgres  # Options: postgres, mongodb, mysql, sqlite

# Common Database Settings
DB_HOST=localhost
DB_PORT=5432  # Default ports: PostgreSQL=5432, MongoDB=27017, MySQL=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# SQLite Specific
DB_PATH=./data/database.db  # Only for SQLite

# MongoDB Specific
MONGO_AUTH_SOURCE=admin  # Authentication database for MongoDB

# PostgreSQL Specific
POSTGRES_SCHEMA=public  # Default schema for PostgreSQL

# MySQL Specific
MYSQL_CHARSET=utf8mb4  # Character set for MySQL

# API Settings
ANTHROPIC_API_KEY=your_anthropic_api_key
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false 